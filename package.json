        "@tanstack/react-query": "^5.102.8",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.2.5",
        "lucide-react": "^1.41.0",
        "next": "16.3.4",
        "next-intl": "^4.14.2",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "recharts": "^3.10.1",
