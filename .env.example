# Copy to .env.local. For local development the values come from
# `supabase status`; the publishable key is safe in the browser because RLS is
# what protects the data, the secret key bypasses RLS and is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# The app's own public origin. Magic-link emails point back here, so it is set
# explicitly rather than derived from the Host header. Must match (or be listed
# in) supabase/config.toml's auth.site_url / additional_redirect_urls.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
