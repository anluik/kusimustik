# Copy to .env.local. For local development the values come from
# `supabase status`; the publishable key is safe in the browser because RLS is
# what protects the data, the secret key bypasses RLS and is server-only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
